NODE_ENV=development
PORT=3000

# PostgreSQL - su Railway usa DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/festa_laurea

# Sessioni admin (stringa lunga e casuale, es: openssl rand -hex 32)
SESSION_SECRET=

# Credenziali pannello admin
ADMIN_USERNAME=francesco
ADMIN_PASSWORD_HASH=

# Gmail SMTP - usare una Google App Password, MAI la password normale
GMAIL_USER=
GOOGLE_APP_PASSWORD=
MAIL_FROM_NAME=Festa di Laurea - Francesco

# Dati evento (mostrati sul sito e nelle email)
EVENT_NAME=Festa di Laurea di Francesco Pio Colacino
EVENT_DATE=26 settembre 2026
EVENT_TIME=18:30
EVENT_LOCATION_NAME=
EVENT_ADDRESS=
# Facoltativo: nota breve mostrata sotto i dettagli evento (es. raccomandazioni)
EVENT_NOTE=
# Facoltativo: link diretto a Google Maps per il pulsante "Apri su Maps".
# Se impostato ha la precedenza sulla ricerca costruita da EVENT_ADDRESS.
EVENT_MAPS_URL=
